@page "/settings"
@inject DatabaseService DbService
@inject GoogleDriveBackupService BackupService
@inject LocalServerService ServerService
@inject ChildSyncService ChildSync
@inject IJSRuntime JSRuntime

<div style="display: flex; flex-direction: column; gap: 20px;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h2>⚙️ Configuración General del Sistema</h2>
            <p style="color: var(--md-text-secondary); font-size: 13px;">
                Datos de la pastelería, facturación fiscal DGI, arquitectura de red, multimoneda y respaldos.
            </p>
        </div>
        <button class="md-btn md-btn-primary" @onclick="SaveSettingsAsync">
            💾 Guardar Cambios
        </button>
    </div>

    @if (showSuccessAlert)
    {
        <div style="background: var(--md-success-light); color: var(--md-success); padding: 12px 16px; border-radius: var(--md-radius-md); font-weight: 600;">
            ✅ Configuración guardada correctamente.
        </div>
    }

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
        <!-- Business Details -->
        <div class="md-card">
            <div class="md-card-header">
                <div class="md-card-title">🏪 Datos de la Pastelería & Encabezado de Ticket</div>
            </div>

            <div class="md-form-group">
                <label class="md-label">Nombre Comercial</label>
                <input type="text" class="md-input" @bind="settings.BusinessName" />
            </div>

            <div class="md-form-group">
                <label class="md-label">Razón Social</label>
                <input type="text" class="md-input" @bind="settings.BusinessLegalName" />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div class="md-form-group">
                    <label class="md-label">RUC Nicaragua</label>
                    <input type="text" class="md-input" @bind="settings.Ruc" />
                </div>
                <div class="md-form-group">
                    <label class="md-label">Teléfono</label>
                    <input type="text" class="md-input" @bind="settings.Phone" />
                </div>
            </div>

            <div class="md-form-group">
                <label class="md-label">Dirección</label>
                <input type="text" class="md-input" @bind="settings.Address" />
            </div>
        </div>

        <!-- DGI Fiscal Settings -->
        <div class="md-card">
            <div class="md-card-header">
                <div class="md-card-title">⚖️ Facturación Fiscal DGI Nicaragua</div>
            </div>

            <div class="md-form-group">
                <label style="display: flex; align-items: center; gap: 8px; font-weight: 600; cursor: pointer;">
                    <input type="checkbox" @bind="settings.EnableDgiFiscal" />
                    <span>Habilitar Facturación Fiscal DGI (IVA 15%)</span>
                </label>
            </div>

            <div class="md-form-group">
                <label class="md-label">No. Resolución Autorización DGI</label>
                <input type="text" class="md-input" @bind="settings.FiscalAuthorizationResolution" />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div class="md-form-group">
                    <label class="md-label">Prefijo Fiscal</label>
                    <input type="text" class="md-input" @bind="settings.FiscalPrefix" />
                </div>
                <div class="md-form-group">
                    <label class="md-label">Consecutivo Actual</label>
                    <input type="number" class="md-input" @bind="settings.CurrentFiscalNumber" />
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div class="md-form-group">
                    <label class="md-label">Moneda Predeterminada</label>
                    <input type="text" class="md-input" @bind="settings.DefaultCurrency" />
                </div>
                <div class="md-form-group">
                    <label class="md-label">Tipo de Cambio USD ($ -> C$)</label>
                    <input type="number" step="0.01" class="md-input" @bind="settings.UsdExchangeRate" />
                </div>
            </div>
        </div>

        <!-- Network Architecture / Multi-device Sync -->
        <div class="md-card">
            <div class="md-card-header">
                <div class="md-card-title">🌐 Arquitectura de Red (Servidor Central / Hija)</div>
            </div>

            <div class="md-form-group">
                <label class="md-label">Modo de Operación de esta Terminal</label>
                <select class="md-select" @bind="settings.ServerMode">
                    <option value="Standalone">Autónomo (Standalone)</option>
                    <option value="CentralServer">Servidor Central (Recibe conexiones de Hijas)</option>
                    <option value="ChildClient">Terminal Hija (Se conecta al Servidor Central)</option>
                </select>
            </div>

            @if (settings.ServerMode == "CentralServer")
            {
                <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 12px;">
                    <div class="md-form-group">
                        <label class="md-label">Puerto Servidor</label>
                        <input type="number" class="md-input" @bind="settings.LocalServerPort" />
                    </div>
                    <div class="md-form-group">
                        <label class="md-label">Token para Hijas</label>
                        <input type="text" class="md-input" @bind="settings.CentralServerToken" />
                    </div>
                </div>
            }
            else if (settings.ServerMode == "ChildClient")
            {
                <div class="md-form-group">
                    <label class="md-label">URL del Servidor Central</label>
                    <input type="text" class="md-input" placeholder="http://192.168.1.100:5055" @bind="settings.CentralServerUrl" />
                </div>

                <div class="md-form-group">
                    <label class="md-label">Token de Conexión</label>
                    <input type="text" class="md-input" @bind="settings.CentralServerToken" />
                </div>

                <button class="md-btn md-btn-outlined" @onclick="TestCentralConnectionAsync">
                    🔗 Probar Conexión & Sincronizar Catálogo
                </button>

                @if (!string.IsNullOrEmpty(syncStatusMessage))
                {
                    <div style="font-size: 12px; margin-top: 8px; color: var(--md-primary); font-weight: 600;">
                        @syncStatusMessage
                    </div>
                }
            }
        </div>

        <!-- Cloud Backups & Integrations -->
        <div class="md-card">
            <div class="md-card-header">
                <div class="md-card-title">☁️ Respaldo en la Nube & Gemini AI</div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div class="md-form-group">
                    <label class="md-label">Hora Respaldo Google Drive (HH:mm)</label>
                    <input type="text" class="md-input" placeholder="22:00" @bind="settings.BackupHour" />
                </div>
                <div style="display: flex; align-items: flex-end; margin-bottom: 14px;">
                    <button class="md-btn md-btn-secondary" style="width: 100%;" @onclick="TriggerManualBackupAsync">
                        💾 Respaldar BD Ahora
                    </button>
                </div>
            </div>

            <div class="md-form-group">
                <label class="md-label">Google Gemini API Key (Opcional)</label>
                <input type="password" class="md-input" placeholder="AIzaSy..." @bind="settings.GeminiApiKey" />
            </div>

            <div class="md-form-group">
                <label style="display: flex; align-items: center; gap: 8px; font-weight: 600; cursor: pointer;">
                    <input type="checkbox" @bind="settings.FirebaseEnabled" />
                    <span>Habilitar Sincronización Opcional Firebase</span>
                </label>
            </div>

            @if (settings.FirebaseEnabled)
            {
                <div class="md-form-group">
                    <label class="md-label">Firebase Project ID</label>
                    <input type="text" class="md-input" @bind="settings.FirebaseProjectId" />
                </div>
            }
        </div>
    </div>
</div>

@code {
    private AppSettings settings = new();
    private bool showSuccessAlert = false;
    private string syncStatusMessage = "";

    protected override async Task OnInitializedAsync()
    {
        var db = await DbService.GetConnectionAsync();
        settings = await db.Table<AppSettings>().FirstOrDefaultAsync() ?? new AppSettings();
    }

    private async Task SaveSettingsAsync()
    {
        var db = await DbService.GetConnectionAsync();
        await db.UpdateAsync(settings);
        showSuccessAlert = true;
        StateHasChanged();
        await Task.Delay(3000);
        showSuccessAlert = false;
        StateHasChanged();
    }

    private async Task TriggerManualBackupAsync()
    {
        var path = await BackupService.ExecuteBackupAsync("Manual");
        await JSRuntime.InvokeVoidAsync("alert", $"Respaldo generado exitosamente:\n{path}");
    }

    private async Task TestCentralConnectionAsync()
    {
        syncStatusMessage = "Probando conexión con el servidor central...";
        var (success, msg) = await ChildSync.TestConnectionAsync(settings.CentralServerUrl, settings.CentralServerToken);
        syncStatusMessage = msg;
        if (success)
        {
            var pullRes = await ChildSync.PullDataFromServerAsync(settings.CentralServerUrl, settings.CentralServerToken);
            syncStatusMessage += " | " + pullRes.Message;
        }
    }
}
