@page "/ai-assistant"
@inject GeminiAiService AiService
@inject DatabaseService DbService

<div style="display: flex; flex-direction: column; gap: 20px;">
    <div>
        <h2>✨ Inteligencia Artificial & Proyección de Demanda</h2>
        <p style="color: var(--md-text-secondary); font-size: 13px;">
            Impulsado por Google Gemini SDK e inferencia heurística local offline para pastelería y cafetería.
        </p>
    </div>

    <!-- Demand Predictions Cards -->
    <div class="md-card">
        <div class="md-card-header">
            <div class="md-card-title">📈 Proyección de Demanda Estimada & Sugerencias de Producción</div>
            <button class="md-btn md-btn-outlined md-btn-sm" @onclick="LoadProjectionsAsync">
                🔄 Recalcular
            </button>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px;">
            @foreach (var p in projections)
            {
                <div style="background: var(--md-surface-variant); padding: 14px; border-radius: var(--md-radius-md); border-left: 4px solid @(p.UrgencyLevel == "Alta" ? "var(--md-danger)" : p.UrgencyLevel == "Media" ? "var(--md-warning)" : "var(--md-success)");">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px;">
                        <div style="font-weight: 700; font-size: 14px;">@p.ProductName</div>
                        <span class="md-badge @(p.UrgencyLevel == "Alta" ? "md-badge-danger" : p.UrgencyLevel == "Media" ? "md-badge-warning" : "md-badge-success")">
                            @p.UrgencyLevel
                        </span>
                    </div>
                    <div style="font-size: 12px; color: var(--md-text-secondary); margin-bottom: 4px;">
                        Stock Actual: <strong>@p.CurrentStock</strong> | Demanda Estimada: <strong>@p.EstimatedWeeklyDemand</strong>
                    </div>
                    <div style="font-size: 12px; color: var(--md-primary); font-weight: 600; margin-bottom: 6px;">
                        🥣 Lote Sugerido: @p.SuggestedProductionBatch unidades
                    </div>
                    <div style="font-size: 11px; color: var(--md-text-muted);">
                        💡 @p.RecommendedReason
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Gemini AI Interactive Chat / Idea Box -->
    <div class="md-card">
        <div class="md-card-header">
            <div class="md-card-title">💬 Asistente IA de Pastelería & Recetas</div>
            <span class="md-badge md-badge-primary">Gemini 2.5 Flash / Modo Offline</span>
        </div>

        <div style="display: flex; gap: 8px; margin-bottom: 12px; flex-wrap: wrap;">
            <button class="md-btn md-btn-outlined md-btn-sm" @onclick='() => SetQuickPrompt("¿Cómo optimizar los costos de insumos en pasteles de tres leches?")'>
                🎂 Costos de Receta
            </button>
            <button class="md-btn md-btn-outlined md-btn-sm" @onclick='() => SetQuickPrompt("Dame 3 ideas de promociones de repostería para días lluviosos en Granada")'>
                🌧️ Ideas de Promoción
            </button>
            <button class="md-btn md-btn-outlined md-btn-sm" @onclick='() => SetQuickPrompt("¿Qué horario es el óptimo para hornear panes y quesadillas?")'>
                🥖 Horarios de Horneado
            </button>
        </div>

        <div style="display: flex; gap: 10px;">
            <input type="text" class="md-input" style="flex: 1;" placeholder="Pregunta a la IA sobre recetas, inventario, promociones o proyecciones..." @bind="userPrompt" @onkeydown="HandleKeyDown" />
            <button class="md-btn md-btn-primary" @onclick="AskAiAsync" disabled="@isLoading">
                @(isLoading ? "Pensando..." : "Enviar Consulta")
            </button>
        </div>

        @if (!string.IsNullOrEmpty(aiResponse))
        {
            <div style="margin-top: 16px; background: var(--md-surface-variant); padding: 16px; border-radius: var(--md-radius-md); border-left: 4px solid var(--md-primary); white-space: pre-wrap; font-size: 13px; line-height: 1.6;">
                @aiResponse
            </div>
        }
    </div>
</div>

@code {
    private List<DemandProjectionResult> projections = new();
    private string userPrompt = "";
    private string aiResponse = "";
    private bool isLoading = false;
    private AppSettings? settings;

    protected override async Task OnInitializedAsync()
    {
        var db = await DbService.GetConnectionAsync();
        settings = await db.Table<AppSettings>().FirstOrDefaultAsync();
        await LoadProjectionsAsync();
    }

    private async Task LoadProjectionsAsync()
    {
        projections = await AiService.CalculateProjectedDemandAsync();
    }

    private void SetQuickPrompt(string text)
    {
        userPrompt = text;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AskAiAsync();
        }
    }

    private async Task AskAiAsync()
    {
        if (string.IsNullOrWhiteSpace(userPrompt)) return;
        isLoading = true;
        aiResponse = "Generando respuesta inteligente...";
        StateHasChanged();

        aiResponse = await AiService.AskGeminiAsync(userPrompt, settings?.GeminiApiKey ?? "");
        isLoading = false;
    }
}
